#!/usr/bin/env python3
import os
import sys
import rnamotifs2
import pybio
import pickle
import random
random.seed(42)
import glob
import time
import datetime
import html
import argparse

dt = datetime.datetime.today()
nocache = time.mktime(dt.timetuple()) # datetime in seconds

parser = argparse.ArgumentParser()
parser.add_argument('-comps', action="store", dest="comps", default=None)
args = parser.parse_args()

comps_folder = os.path.join(rnamotifs2.path.comps_folder, args.comps)
rnamotifs2.data.read_config(args.comps)
rnamotifs2.data.read(args.comps)
rnamotifs2.sequence.load(args.comps)

num_s, num_e, num_c = rnamotifs2.data.dist.get("s", 0), rnamotifs2.data.dist.get("e", 0), rnamotifs2.data.dist.get("c", 0)
print("RNA maps")
print("silenced=%s, enhanced=%s, controls=%s" % (num_s, num_e, num_c))

# ---- run settings, shown in the report header --------------------------
comps_tab = os.path.join(comps_folder, "%s.tab" % args.comps)
comps_config = os.path.join(comps_folder, "%s.config" % args.comps)
use_fdr = bool(getattr(rnamotifs2.data, "use_FDR", False))
perms = int(getattr(rnamotifs2.config, "perms", 0))
beam_width = int(getattr(rnamotifs2.data, "beam_width", 1))
beam_recursive = bool(getattr(rnamotifs2.data, "beam_recursive", False))
if beam_width <= 1:
    search_mode = "greedy (beam_width=1)"
elif beam_recursive:
    search_mode = "recursive beam search (beam_width=%d)" % beam_width
else:
    search_mode = "beam search, restart-only (beam_width=%d)" % beam_width

settings = [
    ("comparison", args.comps),
    ("data file", os.path.basename(comps_tab)),
    ("config file", os.path.basename(comps_config) if os.path.exists(comps_config) else "(defaults)"),
    ("genome", str(getattr(rnamotifs2.data, "genome", "?"))),
    ("data type", str(getattr(rnamotifs2.data, "data_type", "?"))),
    ("half-window (hw)", str(getattr(rnamotifs2.data, "hw", "?"))),
    ("events", "silenced=%s, enhanced=%s, control=%s" % (num_s, num_e, num_c)),
    ("motif search", search_mode),
    ("permutations", "%d%s" % (perms, "" if perms > 0 else " (off - p_emp not meaningful)")),
    ("multiple-testing correction", "Benjamini-Hochberg FDR" if use_fdr else "none (raw Fisher p-values)"),
    ("base motif threshold", str(getattr(rnamotifs2.data, "base_motif_thr", "?"))),
    ("cluster stop threshold", str(getattr(rnamotifs2.data, "cluster_stop_thr", "?"))),
    ("cores", str(getattr(rnamotifs2.data, "cores", "?"))),
]

configs = {}

for region in ["r1s", "r1e", "r2s", "r2e", "r3s", "r3e"]:
    trees = glob.glob(os.path.join(comps_folder, region, "tree*.tab"))
    trees.sort()
    if len(trees)==0: # RESULT from single results0.tab file
        fname = os.path.join(comps_folder, region, "results0.tab")
        if os.path.exists(fname):
            f = open(fname, "rt")
            header = f.readline().replace("\r", "").replace("\n", "").split("\t")
            r = f.readline()
            if r.strip():
                row = dict(zip(header, r.replace("\n", "").replace("\r", "").split("\t")))
                fisher = float(row["fisher"])
                h = int(row["h"])
                motif_cluster = [row["motif"]]
                if fisher<0.05:
                    areas, _, stats = rnamotifs2.search.areas(args.comps, motif=motif_cluster, hw=15, h=h)
                    info = {"region": region, "cn": 0, "cluster": motif_cluster, "fisher": row["fisher"],
                            "h": row["h"], "ig": row.get("ig"), "raw_ig": row.get("raw_ig"),
                            "p_emp": float(row["p_emp"]) if row.get("p_emp") not in (None, "") else None,
                            "n_steps": 1, "found.t": None, "found.c": None, "absent.t": None, "absent.c": None,
                            "specificity": None, "removed.t [%s]" % num_s: None}
                    configs.setdefault(region, []).append((fisher, h, motif_cluster, areas, stats, info))
    else: # RESULTS from tree
        for index, tree_fname in enumerate(trees):
            info = rnamotifs2.draw.read_tree_full(tree_fname)
            h = int(info["h"])
            motif_cluster = info["cluster"]
            areas, _, stats = rnamotifs2.search.areas(args.comps, motif=motif_cluster, hw=15, h=h)
            configs.setdefault(region, []).append((float(info["fisher"]), h, motif_cluster, areas, stats, info))

if not os.path.exists(os.path.join(comps_folder, "rnamap")):
    os.makedirs(os.path.join(comps_folder, "rnamap"))

# find upper limit for ES
max_es = 0
for region, tree_list in configs.items():
    for tree in tree_list:
        fisher, h, motif_list, area, stats, info = tree
        for t in ["s", "e", "c"]:
            if t not in area:
                area[t] = [[0]*251, [0]*251, [0]*251, [0]*251]
        logs, loge = rnamotifs2.compute.es(area["s"], area["e"], area["c"])
        for a in range(0, 4):
            max_es = max(max_es, max(pybio.utils.smooth(logs[a])), max(pybio.utils.smooth(loge[a])))

for region, tree_list in configs.items():
    for index, tree in enumerate(tree_list):
        fisher, h, motif_list, area, stats, info = tree
        logs, loge = rnamotifs2.compute.es(area["s"], area["e"], area["c"])
        for a in range(0, 4):
            image_filename = "%s_tree%s_area%s" % (region, index, a+1)
            rnamotifs2.draw.area("+".join(motif_list), logs[a], loge[a], os.path.join(comps_folder, "rnamap", image_filename), area=a, region=region, limy=max_es, stats=stats)

regions = sorted(configs.keys())

# ---- HTML -----------------------------------------------------------------

def fmt_sci(x):
    """Scientific notation, e.g. 3.26e-05 - used for every statistical value
    (p-values, FDR, specificity, information gain) so magnitudes are always
    directly comparable across rows regardless of scale."""
    if x is None or x == "":
        return "&mdash;"
    return "%.2e" % float(x)

def fmt_num(x):
    return "&mdash;" if x in (None, "") else str(x)

CSS = """
:root {
    --ink: #1b2430; --sub: #5b6b7c; --line: #e3e8ee; --bg: #f6f8fa; --card: #ffffff;
    --blue: #2f6fed; --red: #e6494f; --accent: #f7f9fb;
}
* { box-sizing: border-box; }
body { margin: 0; padding: 32px 40px 64px; background: var(--bg);
       font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
       color: var(--ink); }
h1 { font-size: 22px; margin: 0 0 2px; }
.sub { color: var(--sub); font-size: 13px; margin-bottom: 24px; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; }

.panel { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
         padding: 18px 22px; margin-bottom: 28px; box-shadow: 0 1px 2px rgba(20,30,40,.04); }
.panel h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em;
            color: var(--sub); margin: 0 0 14px; }
.settings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
                 gap: 10px 24px; font-size: 13px; }
.settings-grid .k { color: var(--sub); }
.settings-grid .v { font-weight: 600; }

.region-heading { font-size: 15px; font-weight: 700; margin: 30px 0 12px; color: var(--ink); }
.region-heading .badge { display: inline-block; font-size: 11px; font-weight: 700; color: #fff;
                          border-radius: 4px; padding: 2px 7px; margin-left: 8px; vertical-align: 2px; }
.badge.s { background: var(--blue); }
.badge.e { background: var(--red); }

.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
        padding: 16px 20px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(20,30,40,.04); }
.card-top { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;
            gap: 8px 20px; margin-bottom: 10px; }
.cluster-name { font-size: 17px; font-weight: 700; }
.tree-link { font-size: 12px; color: var(--sub); }
.tree-link a { color: var(--blue); }

.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
             gap: 10px 18px; margin: 12px 0 16px; padding: 12px 14px; background: var(--accent);
             border-radius: 8px; font-size: 12.5px; }
.stat-grid .label { color: var(--sub); display: block; font-size: 10.5px;
                     text-transform: uppercase; letter-spacing: .03em; }
.stat-grid .value { font-weight: 700; font-size: 14px; }

.images { display: flex; gap: 10px; flex-wrap: wrap; }
.images figure { margin: 0; }
.images img { width: 250px; display: block; border-radius: 6px; border: 3px solid var(--line);
              cursor: zoom-in; transition: opacity .1s; }
.images img:hover { opacity: .85; }
.images figcaption { font-size: 10.5px; color: var(--sub); text-align: center; margin-top: 4px; }
.images a { text-decoration: none; }
/* regulation direction, at a glance: blue=silenced/repressed, red=enhanced -
   same convention as the highlight border drawn inside the plots themselves */
.thumb-s, .lightbox img.thumb-s { border-color: var(--blue); }
.thumb-e, .lightbox img.thumb-e { border-color: var(--red); }

/* lightbox: click a thumbnail to open, wheel to zoom, drag to pan once zoomed,
   double-click/Escape/backdrop click to reset/close - no external libraries */
.lightbox { display: none; position: fixed; inset: 0; background: rgba(10,14,20,.9);
            z-index: 1000; align-items: center; justify-content: center; overflow: hidden; }
.lightbox.open { display: flex; }
.lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 4px;
                 background: #fff; /* the plots are saved as transparent PNGs (matplotlib
                    savefig transparent=True) - fine on the page's white background, but
                    the lightbox's dark backdrop would otherwise show through them */
                 border: 3px solid transparent;
                 box-shadow: 0 12px 48px rgba(0,0,0,.5); cursor: zoom-in;
                 transition: transform .08s ease-out; user-select: none; -webkit-user-drag: none; }
.lightbox img.zoomed { cursor: grab; }
.lightbox img.dragging { cursor: grabbing; transition: none; }
.lightbox .hint { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%);
                   color: rgba(255,255,255,.55); font-size: 11.5px; letter-spacing: .02em; }
.lightbox .close { position: fixed; top: 16px; right: 22px; width: 36px; height: 36px;
                     border-radius: 50%; background: rgba(255,255,255,.12); color: #fff;
                     font-size: 20px; line-height: 36px; text-align: center; cursor: pointer; }
.lightbox .close:hover { background: rgba(255,255,255,.22); }
"""

parts = []
parts.append("<h1>RNAmotifs2 &mdash; %s</h1>" % html.escape(args.comps))
parts.append("<div class='sub'>generated %s %s</div>" % (time.strftime("%d.%m.%Y"), time.strftime("%H:%M:%S")))

parts.append("<div class='panel'><h2>Run settings</h2><div class='settings-grid'>")
for k, v in settings:
    parts.append("<div class='k'>%s</div><div class='v mono'>%s</div>" % (html.escape(k), html.escape(str(v))))
parts.append("</div></div>")

for region in regions:
    tree_list = configs[region]
    region_name = {"r1": "R1 (upstream)", "r2": "R2 (splice site)", "r3": "R3 (downstream)"}.get(region[:-1], region)
    direction = "silenced" if region[-1] == "s" else "enhanced"
    badge_class = region[-1]
    any_drawn = False

    rows_html = []
    for index, tree in enumerate(tree_list):
        fisher, h, motif_list, area, stats, info = tree
        logs, loge = rnamotifs2.compute.es(area["s"], area["e"], area["c"])

        draw_row = False
        for a in range(0, 4):
            if max(logs[a]) > max_es/3 or max(loge[a]) > max_es/3:
                draw_row = True
        if not draw_row:
            continue
        any_drawn = True

        tree_file = "https://expressrna.org/rnamotifs2/%s/%s/%s" % (args.comps, region, "tree%s.tab" % index)
        p_emp = info.get("p_emp")
        n_steps = info.get("n_steps", "?")

        stat_cells = []
        stat_cells.append(("FDR q-value" if use_fdr else "p-value (Fisher)", fmt_sci(fisher)))
        stat_cells.append(("perm. p-value (n=%d)" % perms if perms > 0 else "perm. p-value", fmt_sci(p_emp) if perms > 0 else "&mdash;"))
        stat_cells.append(("motifs in cluster", fmt_num(n_steps)))
        stat_cells.append(("h (window height)", fmt_num(h)))
        stat_cells.append(("specificity", fmt_sci(info.get("specificity"))))
        stat_cells.append(("found (%s)" % direction, fmt_num(info.get("found.t"))))
        stat_cells.append(("found (control)", fmt_num(info.get("found.c"))))
        stat_cells.append(("information gain", fmt_sci(info.get("ig"))))

        stat_html = "".join("<div><span class='label'>%s</span><span class='value'>%s</span></div>" % (html.escape(lbl), val)
                            for lbl, val in stat_cells)

        img_html = []
        area_captions = {0: "skip.start", 1: "in.start", 2: "in.stop", 3: "skip.stop"}
        for a in range(0, 4):
            image_filename = "%s_tree%s_area%s.png?nocache=%s" % (region, index, a+1, nocache)
            img_html.append(
                "<figure><a href=%s onclick=\"return openLightbox(event, this.href, '%s')\">"
                "<img class='thumb-%s' src=%s></a>"
                "<figcaption>area %d (0=%s)</figcaption></figure>" % (
                    image_filename, badge_class, badge_class, image_filename, a+1, area_captions[a]))

        rows_html.append("""
<div class='card'>
  <div class='card-top'>
    <div class='cluster-name mono'>%s</div>
    <div class='tree-link'><a href=%s target=_new>tree%s.tab</a> on expressRNA</div>
  </div>
  <div class='stat-grid'>%s</div>
  <div class='images'>%s</div>
</div>""" % ("+".join(motif_list), tree_file, index, stat_html, "".join(img_html)))

    if not any_drawn:
        continue
    parts.append("<div class='region-heading'>%s <span class='badge %s'>%s</span></div>" %
                 (html.escape(region_name), badge_class, direction.upper()))
    parts.extend(rows_html)

if len(regions) == 0 or all(len(configs[r]) == 0 for r in regions):
    parts.append("<div class='panel'>No region reached a significant motif cluster.</div>")

LIGHTBOX = """
<div id="lightbox" class="lightbox" onclick="lbBackdrop(event)">
  <div class="close" onclick="lbClose(event)">&times;</div>
  <img id="lightbox-img">
  <div class="hint">scroll to zoom &middot; drag to pan &middot; double-click or Esc to reset/close</div>
</div>
<script>
(function () {
  var box = document.getElementById('lightbox');
  var img = document.getElementById('lightbox-img');
  var scale = 1, panX = 0, panY = 0;
  var dragging = false, moved = false, startX = 0, startY = 0, offX = 0, offY = 0;

  function apply() {
    img.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
    img.classList.toggle('zoomed', scale > 1);
  }
  function reset() { scale = 1; panX = 0; panY = 0; apply(); }

  window.openLightbox = function (ev, src, dir) {
    ev.preventDefault();
    img.src = src;
    img.className = dir ? 'thumb-' + dir : '';
    reset();
    box.classList.add('open');
    return false;
  };
  window.lbClose = function (ev) { ev.stopPropagation(); box.classList.remove('open'); };
  window.lbBackdrop = function (ev) { if (ev.target === box) box.classList.remove('open'); };

  img.addEventListener('wheel', function (e) {
    e.preventDefault();
    scale = Math.min(6, Math.max(1, scale * (e.deltaY < 0 ? 1.15 : 1 / 1.15)));
    if (scale === 1) { panX = 0; panY = 0; }
    apply();
  }, { passive: false });

  img.addEventListener('dblclick', reset);

  img.addEventListener('mousedown', function (e) {
    dragging = true; moved = false;
    startX = e.clientX; startY = e.clientY; offX = panX; offY = panY;
    img.classList.add('dragging');
    e.preventDefault();
  });
  window.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    var dx = e.clientX - startX, dy = e.clientY - startY;
    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
    if (scale > 1) { panX = offX + dx; panY = offY + dy; apply(); }
  });
  window.addEventListener('mouseup', function () {
    if (dragging && !moved) { // plain click, no drag: toggle zoom in/out
      if (scale > 1) { scale = 1; panX = 0; panY = 0; } else { scale = 2.5; }
      apply();
    }
    dragging = false;
    img.classList.remove('dragging');
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (scale > 1) reset(); else box.classList.remove('open');
  });
})();
</script>
"""

doc = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>RNAmotifs2: %s</title>
<style>%s</style>
</head>
<body>
%s
%s
</body>
</html>
""" % (html.escape(args.comps), CSS, "\n".join(parts), LIGHTBOX)

with open(os.path.join(comps_folder, "rnamap", "index.html"), "wt") as f:
    f.write(doc)
